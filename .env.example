# ─────────────────────────────────────────────────────────────────────────────
# MAM! environment template. Copy to:
#   apps/api/.env          (API — all variables below)
#   .env                   (docker compose — same variables)
# Never commit real values. Production refuses to start with placeholder secrets.
# Generate secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of reverse-proxy hops in front of the API (nginx + Next proxy = 1–2).
TRUST_PROXY=1

# ── Database (PostgreSQL 16+/17 with PostGIS 3.4+) ───────────────────────────
DATABASE_URL=postgresql://mam:CHANGE_ME_DB_PASSWORD@localhost:5432/mam?schema=public&connection_limit=10
POSTGRES_USER=mam
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=mam

# ── Redis (optional in dev; required for multi-instance production) ─────────
REDIS_URL=redis://localhost:6379

# ── Sessions ─────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
COOKIE_SECRET=CHANGE_ME_64_HEX_CHARS
# Production: .mam.id if web and api share a parent domain; leave empty when using the Next.js proxy (recommended).
COOKIE_DOMAIN=
COOKIE_SECURE=

# ── Google OAuth 2.0 (Google Cloud Console → Credentials → OAuth client "Web application") ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Register these exact URIs as "Authorized redirect URIs":
GOOGLE_OAUTH_REDIRECT_URI_WEB=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI_ADMIN=http://localhost:3001/api/v1/auth/google/callback
# Extra accepted ID-token audiences (comma-separated), e.g. if Android uses a different server client ID.
GOOGLE_OAUTH_ALLOWED_AUDIENCES=

# ── OPTIONAL Google Maps Platform — SERVER key (Places API (New) only; restrict by IP/API) ──
# Without it MAM! runs on OpenStreetMap + community places (see docs/integrations/OPENSTREETMAP.md).
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=6000
GOOGLE_PLACES_LANGUAGE=id
GOOGLE_PLACES_REGION=ID

# ── Object storage for review photos ─────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=

# ── Product configuration (defaults; admins can override at runtime) ────────
DEFAULT_RADIUS_METERS=5000
REVIEW_MIN_TEXT_LENGTH=20
REVIEWS_REQUIRE_APPROVAL=false
MAX_REVIEWS_PER_DAY=10

# Emails granted SUPER_ADMIN on first login (comma-separated). Remove after bootstrap.
# ── Outgoing e-mail: staff MFA codes + place approval/rejection notices ──
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# and put the 16-character App Password in SMTP_PASS. The normal Google account password does NOT work.
# Without SMTP_USER/SMTP_PASS (development) e-mails are written to MAIL_OUTBOX_DIR instead of being sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_OUTBOX_DIR=./storage/outbox
# Staff (moderator/admin) password logins require an e-mailed 6-digit code.
STAFF_MFA_REQUIRED=true

BOOTSTRAP_SUPER_ADMIN_EMAILS=
# Development-only password-less login. MUST be false in production (the API refuses to start otherwise).
DEV_LOGIN_ENABLED=false

# ── External food platforms (only with a signed partner agreement) ──────────
GOFOOD_PARTNER_API_KEY=
GRABFOOD_PARTNER_API_KEY=
SHOPEEFOOD_PARTNER_API_KEY=

# ── Web / Admin (Next.js) ────────────────────────────────────────────────────
# Where the Next.js server proxies /api/v1/* (runtime, not build time).
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Map tiles (default OpenStreetMap, no key). The public OSM tile server is for light use only —
# set your own provider for production (e.g. a paid OSM tile service or a self-hosted tile server).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# OPTIONAL Google Maps. Leave empty to use OpenStreetMap only.
# Maps JavaScript API key — BROWSER key restricted by HTTP referrer (never the server key).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Map ID for Advanced Markers (Cloud-based map styling). DEMO_MAP_ID works for development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
