# Copy to secrets.properties (git-ignored). Never commit real keys.
# API base URL (must end with /). Emulator → host machine: http://10.0.2.2:4000/api/v1/
MAM_API_BASE_URL=http://10.0.2.2:4000/api/v1/
MAM_WEB_BASE_URL=https://mam.id
# OAuth 2.0 *Web application* client ID (the server's client ID) used as serverClientId for Credential Manager.
# You must ALSO create an *Android* OAuth client (package id.mam.app.debug + debug SHA-1) in the same Google Cloud project.
GOOGLE_WEB_CLIENT_ID=
# Maps: the app uses OpenStreetMap (osmdroid) - no Maps API key is needed.
