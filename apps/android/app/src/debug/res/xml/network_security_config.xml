<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (overrides src/main/res/xml/network_security_config.xml).
  Allows plain HTTP to any host so a real phone can reach the developer PC's API over Wi-Fi
  (e.g. http://192.168.1.5:4000). Release builds keep cleartext disabled.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
